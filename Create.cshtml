@model KweziHealthESOP.Models.StaffMember

@{
    ViewData["Title"] = "Add Staff Member";
}

<div class="container mt-4">

    <h2>Add Staff Member</h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="StaffId" class="form-label">
                Staff ID
            </label>

            <input asp-for="StaffId" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">
                Full Name
            </label>

            <input asp-for="FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Email
            </label>

            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Position
            </label>

            <input asp-for="Position" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Unit" class="form-label">
                Unit
            </label>

            <input asp-for="Unit" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Staff Member
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>